# Copy this file to .env (same folder) and adjust the values for your machine.

# Application
APP_NAME=Eco-Bin
APP_KEY=change-this-to-a-long-random-string
APP_ENV=development
BASE_URL=http://localhost/eco-bin/backend/public/

# Database (MySQL, used with XAMPP / Laragon)
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecobin_db
DB_CHARSET=utf8mb4
DB_PREFIX=
